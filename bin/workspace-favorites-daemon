#!/usr/bin/env python3
import ast
import json
import os
import subprocess
import sys
import time
from pathlib import Path


LOCK_FILE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "workspace-favorites-daemon.lock"
CONFIG_DIR = Path.home() / ".config" / "workspace-favorites"
CONFIG_FILE = CONFIG_DIR / "config.json"
POLL_INTERVAL = 0.1
APPLY_RETRIES = 3
APPLY_SETTLE_DELAY = 0.05


def run_command(command):
    return subprocess.check_output(command, text=True).strip()


def get_active_workspace():
    output = run_command(["wmctrl", "-d"])
    for line in output.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[1] == "*":
            return parts[0]
    return None


def get_current_favorites():
    raw = run_command(["gsettings", "get", "org.gnome.shell", "favorite-apps"])
    return ast.literal_eval(raw)


def set_current_favorites(favorites):
    subprocess.run(
        ["gsettings", "set", "org.gnome.shell", "favorite-apps", repr(favorites)],
        check=True,
    )


def apply_favorites(favorites):
    for _ in range(APPLY_RETRIES):
        set_current_favorites(favorites)
        time.sleep(APPLY_SETTLE_DELAY)
        if get_current_favorites() == favorites:
            return favorites
    return get_current_favorites()


def ensure_config_dir():
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)


def load_config():
    if CONFIG_FILE.exists():
        return json.loads(CONFIG_FILE.read_text(encoding="utf-8"))

    current = get_current_favorites()
    return {
        "defaultFavorites": current,
        "workspaceFavorites": {},
    }


def save_config(config):
    ensure_config_dir()
    CONFIG_FILE.write_text(json.dumps(config, indent=2) + "\n", encoding="utf-8")


def favorites_for_workspace(config, workspace):
    return config.get("workspaceFavorites", {}).get(workspace) or config["defaultFavorites"]


def persist_workspace_favorites(config, workspace, favorites):
    config.setdefault("workspaceFavorites", {})[workspace] = favorites
    save_config(config)


def acquire_lock():
    ensure_config_dir()
    try:
        import fcntl
    except ImportError:
        return None

    lock_handle = LOCK_FILE.open("w", encoding="utf-8")
    try:
        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.exit(0)
    return lock_handle


def main():
    lock_handle = acquire_lock()
    config = load_config()

    current_workspace = get_active_workspace()
    if current_workspace is None:
        sys.exit(0)

    target = favorites_for_workspace(config, current_workspace)
    current_favorites = get_current_favorites()
    if current_favorites != target:
        current_favorites = apply_favorites(target)

    persist_workspace_favorites(config, current_workspace, current_favorites)
    last_seen_favorites = current_favorites

    while True:
        active_workspace = get_active_workspace()
        if active_workspace is None:
            time.sleep(POLL_INTERVAL)
            continue

        live_favorites = get_current_favorites()

        if active_workspace == current_workspace:
            if live_favorites != last_seen_favorites:
                persist_workspace_favorites(config, current_workspace, live_favorites)
                last_seen_favorites = live_favorites
        else:
            if last_seen_favorites != favorites_for_workspace(config, current_workspace):
                persist_workspace_favorites(config, current_workspace, last_seen_favorites)

            current_workspace = active_workspace
            target = favorites_for_workspace(config, current_workspace)
            if live_favorites != target:
                live_favorites = apply_favorites(target)

            persist_workspace_favorites(config, current_workspace, live_favorites)
            last_seen_favorites = live_favorites

        time.sleep(POLL_INTERVAL)

    if lock_handle:
        lock_handle.close()


if __name__ == "__main__":
    main()
